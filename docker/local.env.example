# DayBook-3.3x local workflow environment (TASK-1001).
#
# Copy this file to docker/local.env and supply real secret values:
#   cp docker/local.env.example docker/local.env
#
# docker/local.env is git-ignored. Supplying secrets through this file (or an
# exported environment) is strongly preferred over Make command-line
# arguments, which are observable in shell history.
#
# LOCAL_TOKEN_KEY: 32-128 ASCII characters from [A-Za-z0-9_-]. The helper
# passes the raw value to auth/api and derives the padded Base64 form for core
# (do not set CORE_SERVER_TOKEN_SIGNING_KEY yourself). Example of a valid
# generated form: 32 random bytes encoded as unpadded Base64url (43 chars).

# Required secrets
LOCAL_DB_PASSWORD=change-me-to-a-long-random-password
LOCAL_TOKEN_KEY=change-me-to-43plus-chars-from-the-set-A-Za-z0-9_-

# Optional non-secret overrides (defaults shown)
# COMPOSE_PROJECT_NAME=daybook-local
# IMAGE_PREFIX=daybook-local
# IMAGE_TAG=dev
# DOCKER_PLATFORM=linux/arm64
# LOCAL_DB_NAME=db
# LOCAL_DB_USER=dbuser
# DB_PORT=35432
# AUTH_PORT=38089
# CORE_PORT=38082
# API_PORT=38081
# APP_PORT=30080
# STARTUP_TIMEOUT=180
