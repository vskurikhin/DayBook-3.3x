' ----------------------------------------------------------------------------
' Диаграмма последовательностей: сценарий теста TestBasicPutGetSingleClient
' (pkg/system_test.go:35-46). Кластер из трёх узлов; один клиент выполняет
' один PUT (llave → cosa), затем один GET (ожидание "cosa").
'
' Диаграмма изображает ФАКТИЧЕСКИЙ путь текущего кода (ветка
' v2-SNAPSHOT-CLEAN-CODE-0-STAGE-1, корневой пакет raft), без учебных
' каталогов part*. GET обслуживается по ReadIndex (Raft §8): без записи
' в журнал, после кворумного подтверждения лидерства через раунд
' AppendEntries; PUT — полный путь фиксации записи журнала.
'
' Evidence (сообщение → файл:строка) приведено в подписях стрелок;
' сводка — в комментарии к каждой фазе ниже.
'
'   Настройка:
'     - pkg/system_test.go:37-39          (NewHarness(3), CheckSingleLeader)
'     - pkg/testharness.go:103-161        (NewHarness: сервисы, ready, HTTP ":0")
'     - pkg/kvservice/kvservice.go:149-171 (New: Fsm = KVService, raft.New + Serve)
'     - raft.go:287-293                   (<-ready → runElectionTimer)
'     - raft_cm_election.go:152-158       (кворум голосов → startLeaderLocked)
'     - raft_cm_leader.go:686-765         (startLeaderLocked: noop, трекер, leaderLoop)
'     - pkg/testharness.go:557-588        (WaitForSingleLeader: опрос IsLeader)
'
'   PUT:
'     - pkg/system_test.go:42             (CheckPut(c1, "llave", "cosa"))
'     - pkg/testharness.go:593-600        (CheckPut → TryPut)
'     - pkg/kvclient/kvclient.go:118-126, 156-187 (Put → send, ротация адресов)
'     - pkg/kvservice/kvservice.go:386-432 (handlePut → rs.Apply → PutResponse)
'     - raft_cm_leader.go:49-90           (cm.Apply → applyCh)
'     - raft_cm_leader.go:490-511         (leaderLoop: dispatchLogs + leaderSendAEs)
'     - raft_cm_log.go:132-206            (dispatchLogs[Unsafe]: индекс/терм, журнал, персист)
'     - raft_cm_replication.go:461-496, 159-205 (leaderSendAEs → AE соседу)
'     - raft_cm_rpc.go:76-230             (ведомый: AppendEntries, персист, Success)
'     - raft_cm_replication.go:305-360    (handleAEReply → applyAESuccessLocked)
'     - commitment.go:104-173             (setMatch → медиана → commitCh)
'     - raft_cm_leader.go:516-547         (commitCh: LeaderCommit наружу, processLogs)
'     - raft_cm_apply.go:84-227           (processLogs → sendBatch → fsmMutateCh)
'     - raft_cm_apply.go:117-139, 14-58   (runFSM → applyBatch → f.respond(nil))
'     - pkg/kvservice/kvservice.go:177-197, 237-244 (Apply/ApplyBatch → ds.Put)
'
'   GET:
'     - pkg/system_test.go:44             (CheckGet(c1, "llave", "cosa"))
'     - pkg/testharness.go:509-523, 605-610 (TryGet/CheckGet, сверка "cosa")
'     - pkg/kvclient/kvclient.go:131-138  (Get → send POST /get/)
'     - pkg/kvservice/kvservice.go:434-468 (handleGet → VerifyLeader → ds.Get)
'     - raft_cm_leader.go:179-196         (cm.VerifyLeader → verifyCh)
'     - raft_cm_leader.go:583-622         (leaderLoop: эпоха, self-голос, pendingVerify)
'     - raft_cm_replication.go:305-332, 367-395 (handleAEReply → голоса → respond(nil))
'     - pkg/kvservice/datastore.go:44-50  (ds.Get → "cosa", true)
'
'   Завершение:
'     - pkg/system_test.go:38             (defer h.Shutdown())
'     - pkg/testharness.go:409-434        (отключения, ctxCancel, Shutdown каждого)
'     - pkg/kvservice/kvservice.go:342-360 (rs.Shutdown, HTTP Shutdown)
'     - server.go:175-183, raft_cm.go:331-342 (cm.Stop: join горутин, transport.Close)
'
'   Временные характеристики (каждое число — с источником; FACT/INFERENCE;
'   среды измерений различаются, числа между средами не сопоставимы —
'   см. итоговую note):
'     - локальный прогон теста целиком (harness + выборы + PUT + GET):
'       одиночный 0.47 с; медиана 0.52 с по 10 прогонам, разброс
'       0.44-0.62 с [FACT: тест, go test -count=10];
'     - окно тайм-аута выборов ведомого: 381-762 мс
'       [INFERENCE: из констант — raft.go:19 (ReelectionTimeoutMs =
'       127*Quantum = 381 мс) и raft_cm_election.go:464-466
'       (381 + rand.Intn(381) мс)];
'     - шаг обработчика AppendEntries на ведомом, пересчёт ns/op → мкс
'       [FACT: CC-002 (.ai/developer/task-report-CC-002.md), медиана
'       ns/op по 10 прогонам, Apple M3 Ultra, MapStorage, без сети]:
'         пустой AE (пульс / раунд VerifyLeader) — 1473 ns/op ≈ 1.5 мкс;
'         AE с записями (батч 16) — 16191.5 ns/op ≈ 16.2 мкс
'         (≈ 1 мкс на запись);
'     - end-to-end на стенде 3×RPi4 под нагрузкой (FileStorage, сеть;
'       итоговые строки loadkv-disk-long.out: concurrency=10,
'       request-rate=300, value-size=128) [FACT: стенд RPi4,
'       data/reports/3×Raspberry_Pi_4_Model_B_1.5,8_Gb_LPDDR4/trace/
'       node-5/data/log/loadkv-disk-long.out]:
'         PUT: p50 31.31 мс, p90 51.56 мс, p95 68.36 мс, p99 146.90 мс,
'              mean 36.71 мс, max 55022.85 мс (count 4918884);
'         GET: p50 18.84 мс, p90 42.80 мс, p95 52.10 мс, p99 120.60 мс,
'              mean 22.37 мс, max 55023.12 мс (count 16387078);
'     - ожидание кворума при PUT: не дольше одного раунда рассылки
'       AE/пульса ≈ ≤ 33 мс [INFERENCE: из констант —
'       HeartbeatTimeoutMs = 11*Quantum = 33 мс, raft.go:18];
'     - тайм-аут одного сетевого RPC: 191 мс [FACT: константа
'       TCPRPCTimeout, raft.go:36] — верхняя граница шага, а не типичное
'       значение.
' ----------------------------------------------------------------------------
@startuml BasicPutGetSingleClient
title TestBasicPutGetSingleClient: один клиент, PUT + GET в кластере из трёх узлов\n(фактический путь кода; GET — по ReadIndex, Raft §8, без записи в журнал)

autonumber

participant "Тест / Harness\n(system_test.go, testharness.go)" as TH
participant "Клиент\nkvclient.KVClient" as C
participant "KVService (лидер)\nHTTP-обработчики + FSM/DataStore" as KS
participant "ConsensusModule (лидер)\nrunLeaderLoop, журнал" as L
participant "commitmentTracker" as T
participant "Ведомый 1\nKVService + CM" as F1
participant "Ведомый 2\nKVService + CM" as F2

== Фаза 0. Настройка: подъём кластера и выборы лидера ==

TH -> TH : NewHarness(t, 3):\n3×NewKVService(":0", MapStorage, ready),\nConnectToRaftPeer, close(ready),\nServeHTTP(":0")\n(testharness.go:103-161)
TH -> L : close(ready) →\nrunElectionTimer\n(raft.go:287-293)
L -> F1 : Pre-Vote → выборы:\nRequestVote (терм t)\n(raft_cm_election.go:73-169)
L -> F2 : RequestVote (параллельно)
F1 --> L : VoteGranted
F2 --> L : VoteGranted
L -> L : кворум 2/3 → startLeaderLocked:\nnoop-запись терма (§5.4.2),\nновый commitmentTracker,\nзапуск runLeaderLoop\n(raft_cm_election.go:152-158;\nraft_cm_leader.go:686-765)
TH -> TH : CheckSingleLeader:\nопрос IsLeader() подключённых\nсервисов до единственного лидера\n(testharness.go:485-488, 557-588)
note over TH, F2
  Предыстория сценария: лидер уже избран и зафиксировал noop-запись
  своего терма. Клиент (h.NewClient()) получает список адресов всех
  трёх сервисов (testharness.go:438-440); assumedLeader = 0 — лидера
  клиент не знает и находит обходом сервисов.

  Время фазы: тайм-аут выборов ведомого — случайный в окне
  381-762 мс [INFERENCE: из констант — raft.go:19
  (ReelectionTimeoutMs = 127×Quantum = 381 мс),
  raft_cm_election.go:464-466 (381 + rand.Intn(381) мс)]; ожидание
  этого тайм-аута — основная составляющая фазы. Весь тест целиком
  (harness + выборы + PUT + GET) — медиана 0.52 с [FACT: тест,
  10 прогонов, разброс 0.44-0.62 с].
end note

TH -> C : h.NewClient()\n(testharness.go:41, 438-440)

== Фаза 1. PUT «llave» = «cosa» (CheckPut) ==

TH -> C : CheckPut(c1, "llave", "cosa")\n→ TryPut: ctx 600×Quantum мс\n(system_test.go:42;\ntestharness.go:593-600, 500-504)

opt assumedLeader — не лидер (обход сервисов)
  C -> F1 : POST /put/ {"llave","cosa"}\n(kvclient.go:156-162)
  F1 -> F1 : rs.Apply → cm.Apply:\nstate != Leader →\nerrorFuture{ErrNotLeader}\n(raft_cm_leader.go:64-68)
  F1 --> C : PutResponse{StatusNotLeader}\n(kvservice.go:408-414)
  C -> C : nextLeader():\nпереход к следующему адресу\n(kvclient.go:174-178)
end

C -> KS : POST /put/ {"llave","cosa"}\n(лидер; kvclient.go:156-162)
activate KS
KS -> L : rs.Apply(cmd, 10 c):\nCommand{CommandPut},\nlogFuture → applyCh\n(kvservice.go:399-406;\nserver.go:102-104;\nraft_cm_leader.go:49-90)
activate L
L -> L : leaderLoop case applyCh:\ndispatchLogs — журналу присвоены\nIndex=i, Term=t, персист (MapStorage),\ninflight[i] = future;\ntracker.commit(i): только self\n(raft_cm_leader.go:490-509;\nraft_cm_log.go:132-206)
L -> T : setMatch(лидер, i)\n(raft_cm_log.go:169)
T -> T : медиана {-1, -1, i} не продвигает\ncommitIndex: кворум 2/3 не собран\n(commitment.go:149-173)
L -> F1 : leaderSendAEs →\nAppendEntries: Entries=[Put],\nLeaderCommit = прежний\n(raft_cm_leader.go:511;\nraft_cm_replication.go:461-496, 37-75)
L -> F2 : AppendEntries (параллельно)
activate F1
F1 -> F1 : проверка PrevLogIndex/Term,\nдозапись журнала, персист,\ncommitIndex не меняется\n(raft_cm_rpc.go:113-168, 177-185, 221)
note over F1
  Шаг обработчика на ведомом: AE с записями —
  ≈ 16.2 мкс на батч из 16 записей
  (≈ 1 мкс/запись) [FACT: CC-002,
  BenchmarkCMAppendEntriesEntries,
  медиана 16191.5 ns/op → мкс; MapStorage,
  без сети].
end note
F1 --> L : reply.Success = true
deactivate F1
note over L, F1
  Граница долговечности: Success:true отправляется
  только после персиста принятых записей
  (raft_cm_rpc.go:64-74, 217-228).
end note
F2 --> L : reply.Success = true
L -> T : handleAEReply →\napplyAESuccessLocked:\nmatchIndex[ведомый] = i, setMatch\n(raft_cm_replication.go:305-360)
activate T
T -> T : медиана {i, i, -1} = i;\nтерм i равен t, i ≥ startIndex\n→ commitIndex := i\n(§5.4.2; commitment.go:149-165)
T --> L : commitCh <- i\n(non-blocking, ёмкость 1)\n(commitment.go:166-172)
deactivate T
L -> L : leaderLoop case commitCh:\ncommitIndex := i\n(raft_cm_leader.go:516-520)
L -> F1 : leaderSendAEs:\nAppendEntries LeaderCommit = i\n(raft_cm_leader.go:540)
L -> F2 : AppendEntries LeaderCommit = i
note over L
  Индекс фиксации рассылается ведомым ДО применения
  записи к машине состояний лидера: leaderSendAEs()
  (строка 540) выполняется раньше processLogs(i)
  (строка 544) — применение не задерживает рассылку.
end note
F1 -> F1 : commitIndex = min(LeaderCommit, lastLogIndex)\n→ processLogs → sendBatch →\nrunFSM → FSM.ApplyBatch → ds.Put\n(raft_cm_rpc.go:177-185;\nraft_cm_apply.go:84-227, 117-139;\nkvservice.go:237-244, 177-197)
F2 -> F2 : то же: журнал применён\nк DataStore ведомого
L -> L : processLogs(i):\nlastApplied := i (до применения),\nsendBatch → fsmMutateCh\n(raft_cm_apply.go:84-106, 174-227)
L -> KS : runFSM → FSM.ApplyBatch →\nFSM.Apply: ds.Put("llave","cosa")\n→ ("", false)\n(raft_cm_apply.go:117-139, 35;\nkvservice.go:177-197;\ndatastore.go:55-62)
L -> L : applyBatch: f.response = ответ FSM,\nf.respond(nil) — из runFSM\n(raft_cm_apply.go:52-57)
L --> KS : future.ErrorCh ← nil:\nпробуждает select в handlePut\n(future.go:142-153)
deactivate L
KS --> C : PutResponse{StatusOK,\nKeyFound=false, PrevValue=""}\n(ключ новый; kvservice.go:408-427)
deactivate KS
C --> TH : ("", false, nil) — ошибок нет,\nCheckPut пройден\n(testharness.go:593-600)
note over TH
  Предмет проверки CheckPut — отсутствие ошибки;
  prev/found утверждаются отдельным тестом
  TestPutPrevValue (system_test.go:48-70).
end note
note over C, KS
  Время PUT end-to-end (стенд 3×RPi4, FileStorage + сеть,
  нагрузка concurrency=10, request-rate=300): p50 31.31 мс,
  p95 68.36 мс, p99 146.90 мс (mean 36.71 мс)
  [FACT: стенд RPi4, loadkv-disk-long.out]. В локальном тесте
  доминирует не обработчик, а ожидание кворума: до одного
  раунда рассылки AE ≈ не дольше пульса 33 мс
  [INFERENCE: из констант — HeartbeatTimeoutMs = 11×Quantum,
  raft.go:18]; сам шаг обработчика AE на ведомом — единицы
  мкс [FACT: CC-002, ns/op → мкс]. Числа разных сред
  не сопоставимы между собой.
end note

== Фаза 2. GET «llave» (CheckGet, ожидание «cosa») ==

TH -> C : CheckGet(c1, "llave", "cosa")\n→ TryGet: сверка found и значения\n(system_test.go:44;\ntestharness.go:605-610, 509-523)
note over C
  Обход сервисов тот же, что у PUT:
  StatusNotLeader → nextLeader()
  (kvclient.go:174-178).
end note
C -> KS : POST /get/ {"llave"}\n(kvclient.go:131-138, 156-162)
activate KS
KS -> L : rs.VerifyLeader()\n(ReadIndex, без записи в журнал;\nkvservice.go:447-448; server.go:165-167)
activate L
L -> L : cm.VerifyLeader → verifyCh;\nleaderLoop case verifyCh:\nquorumSize = 2, verifyEpoch++,\nself-голос (1/2),\nзапрос → pendingVerify;\nfirstPending → leaderSendAEs\n(raft_cm_leader.go:179-196, 583-622)
L -> F1 : AppendEntries\n(Entries пуст — фактически пульс;\ndispatchEpoch = verifyEpoch)\n(raft_cm_replication.go:461-496)
note over F1
  Шаг обработчика на ведомом: пустой AE —
  ≈ 1.5 мкс [FACT: CC-002,
  BenchmarkCMAppendEntriesHeartbeat,
  медиана 1473 ns/op → мкс; MapStorage,
  без сети]. Весь раунд VerifyLeader ≈ один
  AE-раунд (одна рассылка + первый ответ
  ведомого добирает кворум).
end note
L -> F2 : AppendEntries (параллельно)
activate F1
F1 --> L : reply.Success = true
deactivate F1
F2 --> L : reply.Success = true
L -> L : handleAEReply →\ncountVerifyVotesLocked:\nголос ведомого засчитан\n(epochs: vf.epoch ≤ dispatchEpoch)\n(raft_cm_replication.go:305-332, 367-395)
L --> KS : verifyFuture.respond(nil):\n1 self + 1 ведомый = кворум 2/3\n(первый же ответ ведомого добирает\nкворум; future.go:83-96)
deactivate L
KS -> KS : ds.Get("llave")\n→ ("cosa", true)\n(локальное чтение DataStore;\nkvservice.go:461-462; datastore.go:44-50)
KS --> C : GetResponse{StatusOK,\nKeyFound=true, Value="cosa"}\n(kvservice.go:463-467)
deactivate KS
C --> TH : ("cosa", true, nil):\nTryGet сверяет value == "cosa"\nи found == true — тест пройден\n(testharness.go:509-523)
note over C, KS
  Время GET end-to-end (стенд 3×RPi4, FileStorage + сеть,
  нагрузка concurrency=10, request-rate=300): p50 18.84 мс,
  p95 52.10 мс, p99 120.60 мс (mean 22.37 мс) — по
  процентилям дешевле PUT того же стенда (нет записи в
  журнал и ожидания фиксации) [FACT: стенд RPi4,
  loadkv-disk-long.out]. Верхняя граница шага рассылки —
  тайм-аут одного RPC 191 мс [FACT: константа
  TCPRPCTimeout, raft.go:36].
end note

